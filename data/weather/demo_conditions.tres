[gd_resource type="Resource" script_class="WeatherCatalog" load_steps=7 format=3]

[ext_resource type="Script" path="res://src/weather/weather_catalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://src/weather/weather_condition.gd" id="2_condition"]

[sub_resource type="Resource" id="Resource_baltic"]
script = ExtResource("2_condition")
id = &"strong_winds_western_baltic"
display_name = "Strong winds"
kind = &"strong_wind"
severity = 1
latitude = 54.78
longitude = 12.2
radius_nm = 9.0
description = "Westerly force 6-7 between Møn and Rügen. Demonstration condition."

[sub_resource type="Resource" id="Resource_biscay"]
script = ExtResource("2_condition")
id = &"storm_bay_of_biscay"
display_name = "Storm warning"
kind = &"storm"
severity = 2
latitude = 45.5
longitude = -7.0
radius_nm = 70.0
description = "Deep low over the Bay of Biscay, gale to storm force. Demonstration condition."

[sub_resource type="Resource" id="Resource_lion"]
script = ExtResource("2_condition")
id = &"mistral_gulf_of_lion"
display_name = "Strong winds (Mistral)"
kind = &"strong_wind"
severity = 1
latitude = 42.6
longitude = 4.5
radius_nm = 45.0
description = "Northerly Mistral funnelling down the Rhône valley. Demonstration condition."

[sub_resource type="Resource" id="Resource_fair"]
script = ExtResource("2_condition")
id = &"fair_balearic_sea"
display_name = "Fair conditions"
kind = &"fair"
severity = 0
latitude = 39.6
longitude = 3.0
radius_nm = 60.0
description = "Settled weather with a moderate breeze. Demonstration condition."

[resource]
script = ExtResource("1_catalog")
conditions = Array[ExtResource("2_condition")]([SubResource("Resource_baltic"), SubResource("Resource_biscay"), SubResource("Resource_lion"), SubResource("Resource_fair")])
